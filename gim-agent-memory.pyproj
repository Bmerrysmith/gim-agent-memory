    <Interpreter Include=".venv\">
      <Id>gim-venv</Id>
      <Version>3.12</Version>
      <Description>GIM Python 3.12.14 (.venv)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <PropertyGroup>
    <PythonCommands>GimWorkshop;GimCheck;GimStatus;GimStorageBenchmark;GimIterationSuite;$(PythonCommands)</PythonCommands>
  </PropertyGroup>
  <Target Name="GimWorkshop" Label="GIM - Workshop demo" Returns="@(Commands)">
    <CreatePythonCommandItem Target="$(MSBuildProjectDirectory)\main.py" TargetType="script" Arguments="workshop-demo --seed 2026 --workshops 3 --episodes 12 --output runs/workshop-g0-g1-demo.json" WorkingDirectory="$(MSBuildProjectDirectory)" ExecuteIn="output">
      <Output TaskParameter="Command" ItemName="Commands" />
    </CreatePythonCommandItem>
  </Target>
  <Target Name="GimCheck" Label="GIM - All tests" Returns="@(Commands)">
    <CreatePythonCommandItem Target="$(MSBuildProjectDirectory)\main.py" TargetType="script" Arguments="check" WorkingDirectory="$(MSBuildProjectDirectory)" ExecuteIn="output">
      <Output TaskParameter="Command" ItemName="Commands" />
    </CreatePythonCommandItem>
  </Target>
  <Target Name="GimStatus" Label="GIM - Status" Returns="@(Commands)">
    <CreatePythonCommandItem Target="$(MSBuildProjectDirectory)\main.py" TargetType="script" Arguments="status" WorkingDirectory="$(MSBuildProjectDirectory)" ExecuteIn="output">
      <Output TaskParameter="Command" ItemName="Commands" />
    </CreatePythonCommandItem>
  </Target>
  <Target Name="GimStorageBenchmark" Label="GIM - Storage benchmark" Returns="@(Commands)">
    <CreatePythonCommandItem Target="$(MSBuildProjectDirectory)\benchmarks\benchmark_storage.py" TargetType="script" Arguments="--output runs/storage-benchmark.json" WorkingDirectory="$(MSBuildProjectDirectory)" ExecuteIn="output">
      <Output TaskParameter="Command" ItemName="Commands" />
    </CreatePythonCommandItem>
  </Target>
  <Target Name="GimIterationSuite" Label="GIM - Iteration suite" Returns="@(Commands)">
    <CreatePythonCommandItem Target="$(MSBuildProjectDirectory)\benchmarks\iteration_suite.py" TargetType="script" Arguments="--label vs-$([System.DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss-fff')) --profile" WorkingDirectory="$(MSBuildProjectDirectory)" ExecuteIn="output">
      <Output TaskParameter="Command" ItemName="Commands" />
    </CreatePythonCommandItem>
  </Target>
</Project>